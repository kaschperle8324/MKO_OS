#!/bin/sh
# Systemweite Voreinstellungen (keine persönlichen Daten)
set -e
# Docker für Benutzer der Gruppe docker; Dienst startet erst bei Bedarf
systemctl disable docker.service docker.socket 2>/dev/null || true
systemctl enable docker.socket 2>/dev/null || true
# Neue Benutzer automatisch in sinnvolle Gruppen
sed -i 's/^#\?EXTRA_GROUPS=.*/EXTRA_GROUPS="audio video plugdev netdev bluetooth lpadmin scanner docker"/' /etc/adduser.conf
sed -i 's/^#\?ADD_EXTRA_GROUPS=.*/ADD_EXTRA_GROUPS=1/' /etc/adduser.conf

# Automatische Sicherheitsupdates (nur Debian-Sicherheitsquelle, Voreinstellung von unattended-upgrades)
cat > /etc/apt/apt.conf.d/20auto-upgrades <<'APT'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
APT

# Firewall: eingehend gesperrt, ausgehend frei; einstellbar unter Systemeinstellungen → Firewall
sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf
sed -i 's/^DEFAULT_INPUT_POLICY=.*/DEFAULT_INPUT_POLICY="DROP"/; s/^DEFAULT_OUTPUT_POLICY=.*/DEFAULT_OUTPUT_POLICY="ACCEPT"/' /etc/default/ufw
systemctl enable ufw.service 2>/dev/null || true
